# Database
DATABASE_URL=mysql://root:password@localhost:3306/tile_store

# Admin panel password (used to log in to /admin)
ADMIN_PASSWORD=your_strong_admin_password
# 32+ char random secret for signing admin session cookies
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=change-this-to-a-32-char-random-string

# Stripe (checkout and webhooks)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Site URL (for Stripe redirects and emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Authentication (Auth.js or Better Auth)
AUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Email (Resend or similar)
RESEND_API_KEY=re_...
EMAIL_FROM=orders@yourstore.com

# Image Upload (choose one)
# Uploadthing
UPLOADTHING_SECRET=sk_live_...
UPLOADTHING_APP_ID=app_...

# OR Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

# OR AWS S3
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name
