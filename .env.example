# Database
DATABASE_URL=mysql://root:password@localhost:3306/app_db
TEST_DATABASE_URL=mysql://root:password@localhost:3306/app_db_test

# Admin Security & Sessions
# Admin plaintext password (development only; in production set ADMIN_PASSWORD_HASH)
ADMIN_PASSWORD=your_strong_admin_password
# scrypt hash of admin password (production; generate via scripts/hash-admin-password.mjs)
# ADMIN_PASSWORD_HASH=...
# 32+ char random secret for signing admin session cookies (SubtleCrypto HMAC-SHA256)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=change-this-to-a-32-char-random-string

# Order Security & Verification
# 32+ char secret for signing time-limited order lookup tokens
ORDER_TOKEN_SECRET=change-this-to-a-32-char-random-hex-for-order-tokens

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payment Provider ("mock" in dev, "stripe" in production)
PAYMENT_PROVIDER=mock

# Stripe (when PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email Service (Resend or similar)
RESEND_API_KEY=re_...
EMAIL_FROM=orders@clayandco.com

# Customer Auth (Auth.js or Better Auth - Phase 5)
AUTH_SECRET=your-auth-secret-32-chars-long
NEXTAUTH_URL=http://localhost:3000

# Observability (Sentry - Phase 6)
# SENTRY_DSN=https://...
# NEXT_PUBLIC_SENTRY_DSN=https://...

# Asset Storage ("local" in dev, "s3" in production)
STORAGE_PROVIDER=local
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket-name
